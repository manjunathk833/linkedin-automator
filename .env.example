# Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY="your_api_key_here"

# Zero-Cost Gmail SMTP Alerting (Optional: 16-character Google App Password)
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
REPORT_RECIPIENT="your_email@gmail.com"

# Default Portal Password for Workday / Darwinbox Account Creation & Sign-In
WORKDAY_DEFAULT_PASSWORD="your_workday_portal_password_here"

