<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Resume</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="header">
        <h1 class="name">{{ profile.personal_details.full_name }}</h1>
        {% if profile.personal_details.label %}
        <h2 class="headline">{{ profile.personal_details.label }}</h2>
        {% endif %}
        <div class="contact-info">
            {{ profile.personal_details.location }} &bull; 
            {{ profile.personal_details.phone }} &bull; 
            <a href="mailto:{{ profile.personal_details.email }}">{{ profile.personal_details.email }}</a>
            {% for social in profile.personal_details.profiles %}
                &bull; <a href="{{ social.url }}">{{ social.network }}</a>
            {% endfor %}
        </div>
    </div>

    {% if profile.personal_details.summary %}
    <div class="section-title">Professional Summary</div>
    <p class="summary-text">{{ profile.personal_details.summary }}</p>
    {% endif %}

    {% if profile.experience_history %}
    <div class="section-title">Experience</div>
    {% for exp in profile.experience_history %}
    <div class="block">
        <div class="block-header">
            <div>
                <span class="role-title">{{ exp.role }}</span>
                {% if exp.company %} | <span class="company-name">{{ exp.company }}</span>{% endif %}
            </div>
            <div class="date-range">
                {{ exp.start_date.strftime('%b %Y') }} – 
                {% if exp.end_date %}{{ exp.end_date.strftime('%b %Y') }}{% else %}Present{% endif %}
            </div>
        </div>
        {% if exp.summary %}<p class="summary-text">{{ exp.summary }}</p>{% endif %}
        <ul>
            {% for achievement in exp.achievements %}
            <li>{{ achievement }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endfor %}
    {% endif %}

    {% if profile.projects %}
    <div class="section-title">Projects</div>
    {% for proj in profile.projects %}
    <div class="block">
        <div class="block-header">
            <div>
                <span class="role-title">{{ proj.name }}</span>
                {% if proj.url %} | <a href="{{ proj.url }}" style="font-size: 8pt; color: #555;">Link</a>{% endif %}
            </div>
            <div class="date-range">
                {% if proj.start_date %}{{ proj.start_date.strftime('%b %Y') }}{% endif %}
                {% if proj.start_date and proj.end_date %} – {% endif %}
                {% if proj.end_date %}{{ proj.end_date.strftime('%b %Y') }}{% endif %}
            </div>
        </div>
        {% if proj.description %}<p class="summary-text" style="margin-bottom: 2pt;">{{ proj.description }}</p>{% endif %}
        <ul>
            {% for highlight in proj.highlights %}
            <li>{{ highlight }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endfor %}
    {% endif %}

    {% if profile.education %}
    <div class="section-title">Education</div>
    {% for edu in profile.education %}
    <div class="block">
        <div class="block-header">
            <div>
                <span class="role-title">{{ edu.institution }}</span>
                | {{ edu.study_type }} in {{ edu.area }}
            </div>
            <div class="date-range">
                {% if edu.start_date %}{{ edu.start_date.strftime('%Y') }} – {% endif %}
                {% if edu.end_date %}{{ edu.end_date.strftime('%Y') }}{% endif %}
            </div>
        </div>
        {% if edu.gpa %}<div style="font-size: 9pt;">{{ edu.gpa }}</div>{% endif %}
    </div>
    {% endfor %}
    {% endif %}

    {% if profile.skills_matrix %}
    <div class="section-title">Skills</div>
    <div class="skills-container">
        {% for category, skills_list in profile.skills_matrix.items() %}
        {% if skills_list is iterable and skills_list is not string and skills_list is not mapping %}
        <div style="margin-bottom: 3pt; font-size: 9.5pt;">
            <strong>{{ category }}:</strong> {{ skills_list | join(', ') }}
        </div>
        {% else %}
        <span class="skill-item">{{ category }}</span>
        {% if not loop.last %}<span class="skill-separator">•</span>{% endif %}
        {% endif %}
        {% endfor %}
    </div>
    {% endif %}
    
    {% if profile.certifications or profile.awards %}
    <div class="section-title">Certifications & Awards</div>
    <ul>
        {% for cert in profile.certifications %}
        <li><strong>{{ cert.name }}</strong> ({{ cert.issuer }}){% if cert.issue_date %} - {{ cert.issue_date.strftime('%Y') }}{% endif %}</li>
        {% endfor %}
        {% for award in profile.awards %}
        <li><strong>{{ award.title }}</strong> by {{ award.awarder }}{% if award.award_date %} - {{ award.award_date.strftime('%Y') }}{% endif %}</li>
        {% endfor %}
    </ul>
    {% endif %}
</body>
</html>
